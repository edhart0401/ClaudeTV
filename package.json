{
  "name": "webos-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "Minimalist home-screen launcher for LG webOS TVs (webOS 6 / Chrome 79 compatible)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "package": "sh scripts/package.sh",
    "install:tv": "sh scripts/install.sh",
    "deploy": "npm run build && npm run package && npm run install:tv",
    "manifest": "node scripts/gen-manifest.mjs",
    "build:legacy": "node compat/build.mjs",
    "test:legacy": "node --test tests/*.test.mjs",
    "preview:legacy": "python3 -m http.server 8766 --bind 127.0.0.1 --directory dist-legacy"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@webos-tools/cli": "^3.2.6",
    "acorn": "^8.19.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "postcss-custom-properties": "^15.0.4",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "core-js": "^3.51.0",
    "preact": "^10.29.8"
  },
  "license": "MIT"
}
